{
  "name": "k3ui",
  "version": "1.2.2",
  "description": "K3ui — Material 3 Expressive web components (Lit + TypeScript + SCSS + Tailwind)",
  "author": "Kam3leoN",
  "license": "MIT",
  "type": "module",
  "main": "./dist/k3ui.js",
  "module": "./dist/k3ui.js",
  "types": "./dist/k3ui.d.ts",
  "style": "./dist/k3ui.css",
  "exports": {
    ".": {
      "types": "./dist/k3ui.d.ts",
      "import": "./dist/k3ui.js",
      "default": "./dist/k3ui.js"
    },
    "./syntax": {
      "types": "./dist/k3ui-syntax.d.ts",
      "import": "./dist/k3ui-syntax.js",
      "default": "./dist/k3ui-syntax.js"
    },
    "./k3ui.css": "./dist/k3ui.css",
    "./fonts.css": "./dist/fonts/fonts.css",
    "./fonts-ui.css": "./dist/fonts/fonts-ui.css",
    "./fonts-code.css": "./dist/fonts/fonts-code.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "dev:qr": "vite --config apps/qr-generator/vite.config.ts",
    "build": "npm run build:lib && npm run build:syntax && npm run build:fonts && npm run build:tokens && npm run manifest && npm run budget:bundle",
    "build:lib": "vite build",
    "manifest": "cem analyze --config custom-elements-manifest.config.mjs",
    "build:fonts": "node scripts/copy-fonts.mjs",
    "build:playground": "vite build --config playground/vite.config.ts",
    "build:qr": "vite build --config apps/qr-generator/vite.config.ts",
    "build:tokens": "node scripts/export-tokens.mjs",
    "budget:bundle": "node scripts/budget-bundle.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update-snapshots": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview --config playground/vite.config.ts",
    "preview:qr": "vite preview --config apps/qr-generator/vite.config.ts",
    "build:syntax": "node scripts/build-syntax.mjs",
    "lighthouse": "node scripts/lighthouse-scores.mjs"
  },
  "keywords": [
    "material-design",
    "material-3",
    "expressive",
    "web-components",
    "lit",
    "k3ui",
    "tailwind"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "homepage": "https://github.com/Kam3leoN/k3ui-expressive#readme",
  "bugs": "https://github.com/Kam3leoN/k3ui-expressive/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kam3leoN/k3ui-expressive.git"
  },
  "dependencies": {
    "@fontsource/google-sans": "^5.3.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "chart.js": "^4.6.1",
    "lit": "^3.2.1",
    "material-shapes-ts": "^0.3.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/testing": "^4.0.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.12",
    "flag-icons": "^7.6.0",
    "jsdom": "^26.0.0",
    "k3ux": "file:../k3ux",
    "sass": "^1.85.1",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.0.9"
  },
  "customElements": "custom-elements.json"
}
